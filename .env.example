# Copy to .env and fill in values
GOOGLE_API_KEY=AIza...
MDB_MCP_CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/pantrpilot
MCP_TRANSPORT=http          # http | stdio
MCP_HTTP_URL=http://127.0.0.1:3001
PORT=8000
# Set to true if behind a corporate proxy that intercepts TLS
MDB_TLS_ALLOW_INVALID_CERTS=false
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here